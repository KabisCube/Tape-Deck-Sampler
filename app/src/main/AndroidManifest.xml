<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="com.tapedecksampler.app.permission.CAPTURE_EVENTS" android:protectionLevel="signature" />
    <uses-permission android:name="com.tapedecksampler.app.permission.CAPTURE_EVENTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <application android:theme="@style/AppTheme" android:label="@string/app_name" android:icon="@drawable/icon" android:allowBackup="false" android:supportsRtl="true">
        <service android:name=".DeviceCaptureService" android:exported="false" android:foregroundServiceType="mediaProjection" />
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
